# Copy to backend/.env and adjust.

# Set DEV_MODE=false in production. When true:
#  - OTP is returned in API responses and the master code 123456 is accepted
#  - the auth token secret falls back to a dev default
DEV_MODE=true

# Database. Dev default is local SQLite; prod should be PostgreSQL (+PostGIS later).
# DATABASE_URL=postgresql+psycopg://agrisetu:agrisetu@localhost:5432/agrisetu
DATABASE_URL=sqlite:///./agrisetu.db

# Run `alembic upgrade head` on startup. Keep true in dev; set false in prod and
# run migrations from the deploy pipeline instead.
AUTO_MIGRATE=true

# Token signing. MUST be set to a long random value in production.
AUTH_SECRET=

# Default currency / country
CURRENCY=INR

# Bootstrap superadmin (seeded by app.seed)
SUPERADMIN_PHONE=919999999998

# --- Live market-price feed (data.gov.in / AGMARKNET) ---
# Leave PRICES_PROVIDER=sample to serve the seeded demo prices (no network/key).
# To pull real government mandi prices: register a free key at https://data.gov.in,
# set PRICES_PROVIDER=data_gov_in and paste the key below, then either hit
# POST /api/admin/prices/refresh (Admin console -> "Refresh prices now") or let the
# scheduler refresh them automatically (see SCHEDULER_INTERVAL_SECONDS).
PRICES_PROVIDER=sample
DATA_GOV_IN_API_KEY=
# PRICES_FEED_LIMIT=500
# When the scheduler is on, refresh live prices at most this often (hours).
# PRICES_REFRESH_HOURS=12

# --- Background scheduler ---
# 0 = off (default). Set to e.g. 3600 to run daily digests, meeting reminders and
# the throttled live-price refresh on an in-process timer every N seconds.
SCHEDULER_INTERVAL_SECONDS=0
# How many hours before a team meeting to remind attendees.
# MEETING_REMINDER_HOURS=24

# --- Brand & operating entity (shown on every invoice/receipt) ---
# KissanSetu is the app/brand; Lanciere Technologies develops, deploys, runs and
# manages it and is the operating entity named on documents. The real values are
# set as defaults in config.py; override here only if they change.
# BRAND_NAME=KissanSetu
# OPERATOR_NAME=Lanciere Technologies
# OPERATOR_ADDRESS=506, 5th Floor, Manjeera Majestic Commercial, Kukatpally
# OPERATOR_CITY=Hyderabad, Telangana 500072
# OPERATOR_REGD_ADDRESS=Regd. Office: Sai Roopa Heights, 555, KPHB Phase 6, Kukatpally, Hyderabad, Telangana 500085
# OPERATOR_PAN=AAFCL3936J
# OPERATOR_GSTIN=36AAFCL3936J1Z9
# SUPPORT_PHONE=+919632229846
# SUPPORT_EMAIL=support@lancieretechnologies.com
# One continuous, gap-free invoice series: <prefix>/<FY>/<seq>,
# e.g. KS/LAN/2026-27/200000000001
# INVOICE_NUMBER_PREFIX=KS/LAN
# INVOICE_SEQ_START=200000000001
# GST % LABELLED on the platform/service-fee line. The amount charged is the
# published pricing rule's tax_pct (set in Admin) — keep the two in step.
# SERVICE_GST_RATE=18

# --- WhatsApp invoice/alert delivery ---
# Provider: "mock" (default — dummy: records messages to an in-app outbox, viewable
# in Admin, no network; lets the flow run before a real BSP) or "gupshup" (real).
# Switch to gupshup once you have WhatsApp Business credentials.
# WHATSAPP_PROVIDER=mock
# For the real provider, nothing sends unless WHATSAPP_ENABLED=true AND keys set:
# WHATSAPP_ENABLED=false
# GUPSHUP_API_KEY=
# GUPSHUP_SOURCE=            # your WhatsApp Business number, digits only
# GUPSHUP_SRC_NAME=          # the Gupshup app name
# Public API base URL, used to build a signed invoice link for WhatsApp document
# delivery (empty = no link sent; in-app download still works).
# PUBLIC_BASE_URL=https://api.kissansetu.in
